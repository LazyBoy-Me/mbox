<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MBoxApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MBox">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:supportsPictureInPicture="true"
            android:exported="true"
            android:theme="@style/Theme.MBox"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Links shared from the player: mbox://subject/<id> -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mbox" android:host="subject" />
            </intent-filter>
        </activity>

        <!-- Buttons inside the picture-in-picture window. -->
        <receiver
            android:name=".PipReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.mbox.PIP_TOGGLE" />
                <action android:name="app.mbox.PIP_NEXT" />
                <action android:name="app.mbox.PIP_BACK10" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
